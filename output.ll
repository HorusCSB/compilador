; Código LLVM gerado
declare i32 @printf(i8*, ...)
@.str = private constant [4 x i8] c"%d\0A\00"

%r = alloca i32
store i32 , i32* %r
%b = alloca i32
store i32 2, i32* %b
%resultado = alloca i32
store i32 , i32* %resultado
%quero = alloca i32
store i32 3, i32* %quero
%gerar = alloca i32
store i32 5, i32* %gerar
%codigo = alloca i32
store i32 8, i32* %codigo
%i = alloca i32
store i32 20, i32* %i
